{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneOrMany",
  "description": "What a content file holds: one entity, or a list of them. Used only to\ngenerate the schemas.",
  "anyOf": [
    {
      "$ref": "#/$defs/CompetitionDef"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompetitionDef"
      }
    }
  ],
  "$defs": {
    "CompetitionDef": {
      "description": "A league, in `competitions/`.",
      "type": "object",
      "properties": {
        "$schema": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "region",
        "teams"
      ]
    }
  }
}
