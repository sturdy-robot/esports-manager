{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneOrMany",
  "description": "What a content file holds: one entity, or a list of them. Used only to\ngenerate the schemas.",
  "anyOf": [
    {
      "$ref": "#/$defs/PlayerDef"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlayerDef"
      }
    }
  ],
  "$defs": {
    "PinnedAttributesDef": {
      "description": "Attributes pinned on a player, in whole points from 1 to 99.",
      "type": "object",
      "properties": {
        "aggression": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "awareness": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "champion_pool_breadth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "composure": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "consistency": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "game_sense": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "laning": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "mechanics": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "positioning": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "potential": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "shotcalling": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "teamwork": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        },
        "work_ethic": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 99,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "PlayerDef": {
      "description": "A player pinned by hand, in `players/`. Every field left out is\ngenerated.",
      "type": "object",
      "properties": {
        "$schema": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "attributes": {
          "$ref": "#/$defs/PinnedAttributesDef"
        },
        "birth_date": {
          "description": "`YYYY-MM-DD`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "family_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "given_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "nationality": {
          "type": [
            "string",
            "null"
          ]
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "team": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "team",
        "role"
      ]
    }
  }
}
