{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneOrMany",
  "description": "What a content file holds: one entity, or a list of them. Used only to\ngenerate the schemas.",
  "anyOf": [
    {
      "$ref": "#/$defs/NationalityDef"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NationalityDef"
      }
    }
  ],
  "$defs": {
    "NameOrderDef": {
      "type": "string",
      "enum": [
        "given_first",
        "family_first"
      ]
    },
    "NationalityDef": {
      "description": "A nationality, in `nationalities/`.",
      "type": "object",
      "properties": {
        "$schema": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "code": {
          "description": "ISO 3166-1 alpha-2, such as `KR`.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "id": {
          "type": "string"
        },
        "name_order": {
          "$ref": "#/$defs/NameOrderDef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name_order"
      ]
    }
  }
}
